# The leakage-model trainer: one run per container start (`python -m trainer train`), meant for a weekly scheduler
# (a Render Cron Job, or cron on any host). It reads the pseudonymised dataset from the private store and writes
# models back to it; it needs no database and serves nothing. See NOTES.md, "Leakage model".
#
#   docker build -f Dockerfile.trainer -t espk-trainer .
#   docker run --rm -e ESPK_DATA_URL=s3://bucket/espk -e AWS_ACCESS_KEY_ID=... -e AWS_SECRET_ACCESS_KEY=... \
#       -e ESPK_S3_ENDPOINT_URL=https://... espk-trainer
#
# Never run it in GitHub Actions: this repository is public, and so are its Actions logs, which would show the model
# metrics (and the store's layout).
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.11 /uv /usr/local/bin/uv

# LightGBM needs the OpenMP runtime, which the slim image lacks.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-cache

# The trainer uses the scoring code (server/), the game profiles (game/) and the simulator (tools/) for its benchmark.
COPY server/ ./server/
COPY shared/ ./shared/
COPY game/ ./game/
COPY tools/ ./tools/
COPY trainer/ ./trainer/

RUN addgroup --system --gid 10001 app && adduser --system --uid 10001 --ingroup app app
USER app

# ESPK_DATA_URL: the store (s3://bucket/prefix, or a path to a mounted directory). For S3-compatible stores also
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and, for anything that is not AWS itself, ESPK_S3_ENDPOINT_URL.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib

CMD ["python", "-m", "trainer", "train"]
