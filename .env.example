# Copy to .env (gitignored) next to docker-compose.yaml. Every variable is optional.

# Email alerts: one outgoing SMTP server for every org. Without a host and a from address, email alerts are off
# (Discord alerts still work). Port 587 uses STARTTLS; for implicit TLS on 465 set ESPK_SMTP_USE_SSL=true.
# ESPK_SMTP_HOST=
# ESPK_SMTP_PORT=587
# ESPK_SMTP_USERNAME=
# ESPK_SMTP_PASSWORD=
# ESPK_SMTP_FROM_ADDRESS=
# ESPK_SMTP_STARTTLS=true

# How long raw positions are kept, in days (default 14).
# ESPK_RETENTION_DAYS=14

# How often the worker scores new data, in seconds (default 300).
# ESPK_SCORING_INTERVAL_S=300

# ESPK_LOG_LEVEL=INFO

# Only for docker-compose.caddy.yaml: the DNS name Caddy gets a certificate for.
# ESPK_DOMAIN=espk.example.org

# Use a prebuilt image instead of building locally, e.g. ghcr.io/<owner>/esp-killer:latest
# ESPK_IMAGE=espk:local

# What the container runs: api (default), worker, or all (both, for single-service hosts such as Render).
# ESPK_ROLE=api
# Set when a TLS-terminating proxy is in front (Render, Caddy).
# ESPK_BEHIND_PROXY=false
